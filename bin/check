#!/bin/bash

set -Ee

# shellcheck source=bin/_output.sh
. "$(dirname "$0")/_output.sh"
trap report_failure ERR

# the steps use `ddev exec`, not `ddev composer`/`yarn`: those sync Mutagen on every call
# (3–6s each). Sync once here instead, so the container has every change made on the host
step "Sync files" ddev mutagen sync

# check if composer.json & lock match
step "Composer validate" ddev exec composer validate --no-check-all --no-check-version --check-lock
step "Composer normalize" ddev exec composer normalize --dry-run

step "PHPStan (static analysis)" ddev exec composer static
step "ESLint (JS)" ddev exec yarn lint:js
step "Stylelint (CSS)" ddev exec yarn lint:css
step "YAML lint" ddev exec composer lint:yaml
step "Twig lint" ddev exec composer lint:twig

# security checks: all run, then the check fails if any did
step_continue "Symfony security check" symfony security:check
step_continue "Composer audit" ddev exec composer audit --abandoned=report
step_continue "Yarn audit (high)" ddev exec yarn audit:high
# informational only: moderate issues are shown but don't fail the check
step "Yarn audit (moderate)" ddev exec yarn audit:moderate || report_warning
fail_if_steps_failed

report_success "All checks passed"
