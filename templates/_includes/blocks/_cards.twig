<div class="blocks-wrap:col-span-12"{{ blockId(block) }}>
    <div class="cards-wrap">
        {% for cardItem in block.cards.all() %}
            {% set cardUrl = cardItem.cardLink.getUrl(false) %}
            <{{ cardUrl ? 'a' : 'div' }}{% if cardUrl %} href="{{ cardUrl }}"{% endif %} class="card">
                {% set image = cardItem.image.one() %}
                {% if image %}
                    {{ image(image, 'card') }}
                {% endif %}

                <h3>{{ cardItem.heading | heading_striptags }}</h3>

                {# heading_striptags keeps <a>, so a link in the text nests inside the card's link,
                   and it strips <p>, so separate paragraphs run together #}
                {{ cardItem.textBlock | heading_striptags }}
            </{{ cardUrl ? 'a' : 'div' }}>
        {% endfor %}
    </div>
</div>
