{% for profile in socialMedia.socialMedia.all() %}
    {% set linkTitle = profile.profileUrl.label(true) ?? profile.platform.label %}

    <a href="{{ profile.profileUrl.url }}" title="{{ linkTitle }}">
        <svg class="size-6 fill-current">
            <use href="{{ craft.vite.asset('public/images/icons-public.svg') }}#social-{{ profile.platform }}"></use>
        </svg>
        <span class="sr-only">{{ linkTitle }}</span>
    </a>
{% endfor %}
