{#
Usage:
{% block head %}
    {{ parent() }}
    {% include '_includes/_meta.twig' with {
        'title': <the full title, incl. the company name — usually block('page_title_wrap')>,
        'description': 'Meta/OG/Twitter Description',
        'url': <relative/url>,
        'image': <asset query, e.g. entry.ogImage>,
        'image_alt': 'Image Alt',
        'robots': <array of robots directives, e.g. ['noindex']>,
    } only %}
{% endblock head %}
#}

{# the title is passed in already composed, so og:/twitter: can't drift from the <title> tag #}
{% set title = (title is defined and title is not empty) ? title | trim : siteInformation.companyName %}

{% if url is not defined %}
    {% set url = craft.app.request.absoluteUrl %}
{% endif %}

{% if description %}
    {% set description = description | replace({ "\n": ' ', "\r": ' ' }) %}
{% endif %}

{% if robots is defined and robots is not empty %}
    <meta name="robots" content="{{ robots | join(', ') }}">
{% endif %}

{% if description %}
    <meta name="description" content="{{ description }}">
{% endif %}

{% set ogTransform = 'ogImage' %}
{% set ogImage = image is defined and image ? image.one() : null %}
{% set ogImageAlt = (image_alt is defined and image_alt) ? image_alt : (ogImage ? ogImage.alt : null) %}

<meta property="og:title" content="{{ title }}">
<meta property="og:type"  content="website">
<meta property="og:url"   content="{{ url }}">
<meta property="og:site_name" content="{{ siteInformation.companyName }}">
{% if ogImage %}
    <meta property="og:image" content="{{ ogImage.getUrl(ogTransform) }}">
    {# read back from the transform: upscaleImages is off, so a small source scales the dimensions down #}
    <meta property="og:image:width"  content="{{ ogImage.getWidth(ogTransform) }}">
    <meta property="og:image:height" content="{{ ogImage.getHeight(ogTransform) }}">
    {% if ogImageAlt %}
        <meta property="og:image:alt" content="{{ ogImageAlt }}">
    {% endif %}
{% else %}
    {# @todo-craft add the fallback OG image at public/images/logo-og.png, matching the ogImage transform's 1200x630 #}
    <meta property="og:image" content="{{ siteUrl('/images/logo-og.png') }}">
    <meta property="og:image:width"  content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ siteInformation.companyName }} Logo">
{% endif %}
{% if description %}
    <meta property="og:description" content="{{ description }}">
{% endif %}

{# X/Twitter falls back to the og: tags above for title, description, image & alt #}
<meta name="twitter:card" content="summary_large_image">
{# @todo-craft update twitter username (if they have one) & uncomment #}
{#<meta name="twitter:site" content="<twitter-username>">#}
