{# parent: layout #}
{% extends '_layout.twig' %}

{% set seo = null %}
{# a template can set pageTitle before this to provide a default; the SEO page title wins when it's filled in #}
{% set pageTitle = pageTitle ?? null %}

{% if entry is defined and entry.seo is defined and entry.seo is not null %}
    {% set seo = entry.seo.one() %}
    {% if seo and seo.pageTitle %}
        {% set pageTitle = seo.pageTitle %}
    {% endif %}
{% endif %}

{% block page_title %}{% if pageTitle %}{{ pageTitle }} | {% endif %}{% if parentPageTitle is defined %}{{ parentPageTitle }} | {% endif %}{% endblock %}

{# lightswitches in the SEO block; SeoModule also drops noindex pages from the sitemap #}
{% set robots = [] %}
{% if seo and seo.seoNoindex %}
    {% set robots = robots | merge(['noindex']) %}
{% endif %}
{% if seo and seo.seoNofollow %}
    {% set robots = robots | merge(['nofollow']) %}
{% endif %}

{% block head %}
    {{ parent() }}

    {% if seo is not null %}
        {% include '_includes/_meta.twig' with {
            'title': pageTitle,
            'description': seo.metaDescription,
            'image': seo.ogImage,
            'image_alt': seo.ogImageAlt,
            'robots': robots,
        } only %}
    {% endif %}
{% endblock head %}

{% block content %}
    {% include '_includes/_blocks.twig' %}
{% endblock %}
